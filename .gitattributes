# Normaliza los finales de línea: LF en el repositorio, nativo en el disco.
* text=auto

*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.php   text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf

# Binarios: que Git no los toque
*.png   binary
*.jpg   binary
*.webp  binary
*.ico   binary
